{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"not": {}, "description": "SQLite requires exactly one writer; scaling is unsupported."},
    "image": {"type": "object", "required": ["repository", "tag", "pullPolicy"], "properties": {
      "repository": {"type": "string", "minLength": 1},
      "tag": {"type": "string", "minLength": 1},
      "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
    }},
    "publicURL": {"type": "string", "pattern": "^https?://[^/]+$"},
    "auth": {"type": "object", "required": ["existingSecret", "passwordKey"], "properties": {
      "existingSecret": {"type": "string", "minLength": 1},
      "passwordKey": {"type": "string", "minLength": 1}
    }},
    "notary": {"type": "object", "properties": {
      "name": {"type": "string"},
      "commissionId": {"type": "string"}
    }},
    "service": {"type": "object", "properties": {
      "type": {"enum": ["ClusterIP"]},
      "port": {"type": "integer", "minimum": 1, "maximum": 65535}
    }},
    "persistence": {"type": "object", "properties": {
      "size": {"type": "string", "minLength": 1},
      "existingClaim": {"type": "string"},
      "storageClass": {"type": "string"},
      "accessModes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod"]}}
    }},
    "ingress": {"type": "object", "properties": {
      "enabled": {"type": "boolean"},
      "host": {"type": "string"},
      "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
      "tls": {"type": "array"}
    }},
    "gcs": {"type": "object", "properties": {
      "bucket": {"type": "string"},
      "credentialsSecret": {"type": "string"},
      "credentialsKey": {"type": "string", "minLength": 1}
    }},
    "serviceAccount": {"type": "object", "properties": {
      "create": {"type": "boolean"},
      "name": {"type": "string"},
      "automountServiceAccountToken": {"type": "boolean"},
      "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
    }},
    "networkPolicy": {"type": "object", "properties": {
      "enabled": {"type": "boolean"},
      "ingress": {"type": "array"},
      "extraEgress": {"type": "array"}
    }}
  }
}
